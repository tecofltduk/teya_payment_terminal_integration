<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nf_pos_teya_payment_integration_configurations" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.teya_payment_terminal_integration</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_payment_terminals_section']" position="inside">
                <setting id="teya_payment_terminal_setting" invisible="1">
                    <field name="module_teya_payment_terminal_integration"/>
                    <field name="teya_store_id" invisible="1"/>
                    <field name="teya_terminal_id" invisible="1"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
