<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nf_pos_teya_payment_integration_payment_method" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.teya_integration</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button class="oe_highlight" name="nf_get_teya_stores" type="object">
                        Get Store
                    </button>
                    <button name="nf_generate_auth_token" string="Generate Token" class="oe_highlight" type="object" invisible="use_payment_terminal != 'teya'"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='active']" position="after">
                <field name="company_id" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='use_payment_terminal']" position="after">
                <field name="teya_payment_mode" invisible="1"/>
                <field name="teya_auth_token" invisible="1"/>
                <field name="teya_refresh_token" invisible="1"/>
                <field name="teya_store_id" invisible="use_payment_terminal != 'teya'"/>
            </xpath>
        </field>
    </record>
</odoo>
