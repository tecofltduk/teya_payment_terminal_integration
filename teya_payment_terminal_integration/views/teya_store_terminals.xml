<odoo>
    <record id="view_terminal_device_form" model="ir.ui.view">
        <field name="name">teya.terminal.device.form</field>
        <field name="model">teya.terminal.device</field>
        <field name="arch" type="xml">
            <form string="Teya Terminal Device" edit="0">
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Terminal" class="oe_inline"/></h1>
                    </div>
                    <group>
                        <field name="terminal_id"/>
                        <field name="terminal_name"/>
                        <field name="store_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_terminal_device_tree" model="ir.ui.view">
        <field name="name">teya.terminal.device.tree</field>
        <field name="model">teya.terminal.device</field>
        <field name="arch" type="xml">
            <tree string="Terminal Devices">
                <field name="name"/>
                <field name="terminal_id"/>
                <field name="terminal_name"/>
            </tree>
        </field>
    </record>

    <record id="action_terminal_device" model="ir.actions.act_window">
        <field name="name">Terminal Devices</field>
        <field name="res_model">teya.terminal.device</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_teya_terminal_devices"
        name="Terminal Devices"
        parent="main_teya_menu"
        sequence="2"
        action="action_terminal_device"
        groups="point_of_sale.group_pos_manager"/>

</odoo>
