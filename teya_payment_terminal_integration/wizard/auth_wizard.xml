<odoo>
    <record id="view_teya_verify_wizard_form" model="ir.ui.view">
        <field name="name">teya.verify.wizard.form</field>
        <field name="model">teya.verify.wizard</field>
        <field name="arch" type="xml">
            <form string="My Wizard">
                <group>
                    <field name="qr_code" widget="image" class="oe_avatar"/>
                    OR
                    <field name="verification_uri" widget="url" readonly="1" />
                    <field name="device_code" readonly="1" />
                    <field name="payment_method_id" invisible='1' />
                </group>
                <footer>
                    <button string="Varify" class="btn-secondary" type="object" name="nf_varify_devide" />
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
