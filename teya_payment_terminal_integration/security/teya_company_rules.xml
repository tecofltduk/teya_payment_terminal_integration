<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="teya_store_company_rule" model="ir.rule">
        <field name="name">Teya Store: multi-company</field>
        <field name="model_id" ref="model_teya_store"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="teya_terminal_device_company_rule" model="ir.rule">
        <field name="name">Teya Terminal: multi-company</field>
        <field name="model_id" ref="model_teya_terminal_device"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
